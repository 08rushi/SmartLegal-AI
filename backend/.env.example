# ── Copy this to .env and fill in your values ──────────────────────────────

# Groq AI — get free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# JWT — generate a strong random secret (run: openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary — free at cloudinary.com (for PDF storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database
DATABASE_URL=sqlite:///./smartlegal.db

# App settings
APP_NAME=SmartLegal AI
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Sentry — free at sentry.io (leave blank to disable in dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Redis — leave blank to disable (app falls back to SQLite-only cache)
# Local dev:  redis://localhost:6379
# Render.com: redis://red-xxxx:6379  (shown in your Redis dashboard)
# Meta WhatsApp Cloud API (Step 3A/3B/3C/3D)
META_WHATSAPP_VERIFY_TOKEN=your_verify_token_here
META_WHATSAPP_ACCESS_TOKEN=your_access_token_here
META_WHATSAPP_APP_SECRET=your_app_secret_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_GRAPH_URL=https://graph.facebook.com
