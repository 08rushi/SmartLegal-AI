# ── Copy this to .env and fill in your values ──────────────────────────────

# Gemini AI — get free key at aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# JWT — generate a strong random secret (run: openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary — free at cloudinary.com (for PDF storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database
DATABASE_URL=sqlite:///./smartlegal.db

# App settings
APP_NAME=SmartLegal AI
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
