# ── Copy this to .env and fill in your values ──────────────────────────────

# Groq AI — get free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Speech-to-text model for /api/v1/voice/transcribe
GROQ_STT_MODEL=whisper-large-v3

# JWT — generate a strong random secret (run: openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Runtime environment. FAIL-CLOSED: unset or anything other than development/dev/test/testing
# is treated as PRODUCTION (strict config validation, Secure cookies, no localhost CORS).
# For local development set ENVIRONMENT=development explicitly.
ENVIRONMENT=development
# Dev only (needs ENVIRONMENT=development): return the password-reset token in the
# /forgot-password response when no email provider is configured. Never honoured in production.
EXPOSE_RESET_TOKEN_IN_RESPONSE=false
# DEPRECATED: also return `access_token` in login/register/google JSON bodies. The credential is the
# HttpOnly `sl_token` cookie; enable only while a legacy frontend still reads the body token.
AUTH_RETURN_BODY_TOKEN=false

# Cloudinary — free at cloudinary.com (for PDF storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database
DATABASE_URL=sqlite:///./smartlegal.db

# App settings
APP_NAME=SmartLegal AI
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Sentry — free at sentry.io (leave blank to disable in dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Redis — leave blank to disable (app falls back to SQLite-only cache)
# Local dev:  redis://localhost:6379
# Render.com: redis://red-xxxx:6379  (shown in your Redis dashboard)
# Meta WhatsApp Cloud API (Step 3A/3B/3C/3D)
META_WHATSAPP_VERIFY_TOKEN=your_verify_token_here
META_WHATSAPP_ACCESS_TOKEN=your_access_token_here
META_WHATSAPP_APP_SECRET=your_app_secret_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_GRAPH_URL=https://graph.facebook.com

# Password-reset email via Resend (https://resend.com). Blank = email disabled (dev prints token).
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173

# Schema management. Blank = auto: true for SQLite/dev, false for production + Postgres
# (startup then verifies the DB is at Alembic head and refuses to boot otherwise —
# run `alembic upgrade head` as a deploy step). Set true/false to override.
AUTO_CREATE_SCHEMA=

# Optional SMTP sender (use when you have no verified Resend domain), e.g. Gmail + app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
